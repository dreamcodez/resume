{
  "name": "resume-yew",
  "version": "0.1.0",
  "description": "Matthew Elders' Resume - Rust/WebAssembly Showcase",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./styles/input.css -o ./styles/output.css --watch",
    "build:css:prod": "tailwindcss -i ./styles/input.css -o ./styles/output.css --minify",
    "dev": "trunk serve",
    "build": "trunk build",
    "serve": "trunk serve",
    "test": "npm run test:unit",
    "test:unit": "cargo test --lib",
    "test:browser": "wasm-pack test --headless --firefox",
    "test:all": "npm run test:unit && npm run test:browser"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/tests/.*.spec.js$",
      "<rootDir>/tests/.*.spec.ts$"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/tests/**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "jest": "^30.0.3",
    "tailwindcss": "^3.4.1"
  }
}
