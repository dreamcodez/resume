{
  "name": "resume-yew",
  "version": "0.1.0",
  "description": "Matthew Elders' Resume - Rust/WebAssembly Showcase",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./styles/input.css -o ./styles/output.css --watch",
    "build:css:prod": "tailwindcss -i ./styles/input.css -o ./styles/output.css --minify",
    "dev": "trunk serve",
    "build": "trunk build",
    "serve": "trunk serve",
    "test": "wasm-pack test --headless --firefox --no-default-features",
    "test:node": "wasm-pack test --node --no-default-features",
    "test:chrome": "wasm-pack test --headless --chrome --no-default-features",
    "test:firefox": "wasm-pack test --headless --firefox --no-default-features",
    "test:jest": "jest",
    "test:playwright": "npx playwright test",
    "test:all": "wasm-pack test --headless --chrome && npm run test:jest && npm run test:playwright",
    "test:update-screenshots": "npx playwright test --update-snapshots",
    "test:report": "npx playwright show-report"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/tests/.*\\.spec\\.js$",
      "<rootDir>/tests/.*\\.spec\\.ts$"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/tests/**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@tailwindcss/typography": "^0.5.10",
    "jest": "^30.0.3",
    "tailwindcss": "^3.4.1"
  }
}
